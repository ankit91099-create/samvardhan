# ─────────────────────────────────────────────────────────────────────────────
# COPY THESE INTO HOSTINGER → Settings → Environment Variables
# DO NOT upload this file — add each key/value in the Hostinger panel
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# MongoDB Atlas SRV string (get from Atlas → Connect → Drivers)
MONGO_URI=mongodb+srv://ankit910990_db_user:XpVxrCK5USzzBz6L@samvardhan.ndjqpa1.mongodb.net/?appName=Samvardhan

# JWT — use a strong random string (min 64 chars)
JWT_SECRET=REPLACE_WITH_STRONG_64_CHAR_SECRET
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_STRONG_64_CHAR_SECRET
JWT_REFRESH_EXPIRES_IN=30d

# Admin login credentials (seeded on first boot)
ADMIN_SEED_EMAIL=admin@samvardhanbloom.com
ADMIN_SEED_PASSWORD=Admin@123!

# CORS — your Hostinger frontend domain (no trailing slash)
ALLOWED_ORIGINS=https://your-frontend-domain.hostingersite.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Razorpay (optional — leave placeholder if not using payments yet)
RAZORPAY_KEY_ID=rzp_test_REPLACE
RAZORPAY_KEY_SECRET=REPLACE
RAZORPAY_WEBHOOK_SECRET=REPLACE

# Email (optional — leave placeholder if not using email yet)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_app_password
NOTIFY_EMAIL=admin@samvardhanbloom.com
FROM_NAME=Samvardhan Bloom
CENTRE_PHONE=+91 95872 46814

# Anthropic Chatbot (optional)
ANTHROPIC_API_KEY=sk-ant-REPLACE
